# Copy to .env.local for local development (git ignores it).
#
# Base URL of the YouTube import API. Leave unset to build without the YouTube
# link box. It is compiled into the public JavaScript like every VITE_ variable,
# so never put a secret here. Production uses https://api.sloverb.app, set in Vercel.
VITE_IMPORT_API_URL=http://localhost:10000
